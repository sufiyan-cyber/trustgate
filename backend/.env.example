# ==========================================================
# TRUST GATE: Backend Environment Configuration
# ==========================================================

# 1. LLM & Vision Providers (Groq + Gemini Multi-Provider with Auto-Failover)
# Get free Groq key at: https://console.groq.com
GROQ_API_KEY=""

# Get Google Gemini / GCP key at: https://aistudio.google.com or GCP console
GEMINI_API_KEY=""

# Model selection
GROQ_MODEL="llama-3.3-70b-versatile"
GEMINI_MODEL="gemini-1.5-flash"

# Document OCR Extraction Engine: "GEMINI", "TEXTRACT", or "AUTO"
# Set to "GEMINI" to use your GCP / Gemini Vision multimodal OCR (Recommended)
OCR_PROVIDER="AUTO"

# 2. AWS Textract (Optional - only needed if you choose AWS over Google Cloud)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"

# 3. Hardware Serial Port Configuration
# Set to "AUTO" or specific port e.g. "COM3", "COM4", "/dev/ttyUSB0"
SERIAL_PORT="AUTO"
SERIAL_BAUD_RATE=115200
GATE_OPEN_DURATION_MS=5000

# 4. Security & JWT
JWT_SECRET="trustgate-secret-key-change-in-production-2026"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"
